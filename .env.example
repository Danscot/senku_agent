# ════════════════════════════════════════════════════════
#  Senku Coding Agent — Environment Configuration
#  Copy this to .env and fill in your values.
#  All TOKENS_* and TEMPERATURE_* vars are optional —
#  defaults are already set in config.py.
# ════════════════════════════════════════════════════════


# ── API Keys (at least one required) ────────────────────
NVIDIA_API_KEY=nvapi-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# Custom OpenAI-compatible endpoint (optional)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

FIRECRAWL_API_KEY=

# ── Per-stage model routing ──────────────────────────────
# Format: "provider:model-name"
# Providers: nvidia | openai | gemini | anthropic | openrouter | custom
STAGE_THINK=gemini:gemma-4-31b-it
STAGE_ACT=gemini:gemma-4-31b-it
STAGE_RESPOND=gemini:gemma-4-31b-it
STAGE_COMPRESS=gemini:gemini-3.1-flash-lite


# ── Thinking / Chain-of-Thought ──────────────────────────
# Set to false for classic (non-thinking) models like gpt-4o, gemini-flash
# Set to true for thinking models like gemma-4, QwQ, DeepSeek-R1, Kimi-K2
THINKING_ENABLED=true

# Token budget for the thinking phase (only used when THINKING_ENABLED=true)
# Thinking models need this headroom before they start producing actual output.
# Gemma-4-31b: 4000–8000 recommended. QwQ / Kimi-K2: 8000–16000.
THINKING_BUDGET=8000


# ── Token budgets per call site ──────────────────────────
# Increase these if you hit truncation. Thinking models need higher values
# because the <thought> block consumes tokens before the answer starts.

# Core pipeline stages
TOKENS_THINK=16000
TOKENS_ACT=4000
TOKENS_RESPOND=12000
TOKENS_COMPRESS=2000

# Skills
TOKENS_CODE_WRITER=8000
TOKENS_CODE_REVIEWER=4000
TOKENS_PROJECT_SCANNER=1000
TOKENS_TEST_RUNNER=4000
TOKENS_DEPENDENCY_RESOLVER=1200
TOKENS_MEMORY_COMPRESS=800


# ── Temperature ──────────────────────────────────────────
# 0.0 = deterministic (best for planning/tool calls)
# 0.3 = slightly creative (good for final response)
TEMPERATURE_THINK=0.0
TEMPERATURE_ACT=0.0
TEMPERATURE_RESPOND=0.3
TEMPERATURE_SKILLS=0.2


# ── Project root ─────────────────────────────────────────
PROJECT_ROOT=/path/to/your/project
