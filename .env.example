# ─── API Keys ─────────────────────────────────────────────────────────────────
# Fill in the key(s) for whichever provider(s) you use.
# You only need the keys for providers you actually use.

NVIDIA_API_KEY=nvapi-your-key-here
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=AIza-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional: custom OpenAI-compatible endpoint
# CUSTOM_API_KEY=your-key
# CUSTOM_BASE_URL=https://your-host/v1

# ─── Per-stage model config ───────────────────────────────────────────────────
# Format: "provider:model-name"
# Supported providers: nvidia | openai | gemini | anthropic | openrouter | custom
#
# Leave any stage unset to use the default below (nvidia kimi-k2-thinking).
#
# Examples:
#   STAGE_THINK=nvidia:moonshotai/kimi-k2-thinking     # strong planner
#   STAGE_ACT=gemini:gemini-2.0-flash-lite             # cheap + fast for tool checks
#   STAGE_RESPOND=openai:gpt-4o                        # best quality for user output
#   STAGE_COMPRESS=openai:gpt-4o-mini                  # cheap summariser

STAGE_THINK=nvidia:z-ai/glm-5.2
STAGE_ACT=nvidia:z-ai/glm-5.2
STAGE_RESPOND=gemini:gemini-3.1-flash-lite
STAGE_COMPRESS=gemini:gemini-3.1-flash-lite

# ─── Legacy single-model override ────────────────────────────────────────────
# If set, overrides ALL stage configs above (backward-compatible).
# AGENT_MODEL=moonshotai/kimi-k2-thinking

# ─── Project root ─────────────────────────────────────────────────────────────
# The directory the agent operates on.
# Can also be overridden with: python main.py --project /path/to/project
PROJECT_ROOT=/home/ubuntu/senku_agent/src

